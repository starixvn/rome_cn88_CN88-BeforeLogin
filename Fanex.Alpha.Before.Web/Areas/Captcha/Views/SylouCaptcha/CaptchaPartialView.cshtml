@model CaptchaMvc.Models.DefaultBuildInfoModel
@{
    string id = Guid.NewGuid().ToString("N");

    string reloadCaptchaFunctionName = string.Format("______{0}________", Guid.NewGuid().ToString("N"));
}

@Html.Hidden("CaptchaId", id)
@Html.Hidden("ModelRefreshUrl", Model.RefreshUrl)
@Html.Hidden("ModelTokenParameterName", Model.TokenParameterName)
@Html.Hidden("ModelTokenElementId", Model.TokenElementId)
@Html.Hidden("NoInteractionTimeInMinutes", Fanex.Alpha.Before.Customer.Configurations.AlphaCommonSection.Instance.NoInteractionTimeInMinutes * 60 * 1000)
@Html.Hidden("ModelImageElementId", Model.ImageElementId)
@Html.Hidden("ReloadCaptchaFunctionName", reloadCaptchaFunctionName)

<div class="rowlg group-captcha">
    <div class="codeCaptcha">
        <img alt="" id="@Model.ImageElementId" src="@Model.ImageUrl" width="124px" height="44px"/>
        @Html.Hidden(Model.TokenElementId, Model.TokenValue)
    </div>

    <div class="action-refresh" id="@id" href="#@Model.ImageElementId">
        <i class="icon-refresh" id="captcha-refresh-icon"></i>
    </div>

    @if (Model.IsRequired)
    {
        @Html.TextBox(Model.InputElementId, null, new Dictionary<string, object>
                            {
                                {"data-val", "true"},
                                {"data-val-required", Model.RequiredMessage},
                                {"id", "recaptcha_response_field"},
                                {"class", "custom-textbox inputCaptcha"},
                                {"tabindex", "4"}
                            })

    }
    else
    {
        @Html.TextBox(Model.InputElementId, null, new { @id = "recaptcha_response_field", @class = "txt txt-validation", @placeholder= @Fanex.Alpha.Before.Customer.Resources.Labels.Validation, @tabindex = "4" })
    }

</div>
