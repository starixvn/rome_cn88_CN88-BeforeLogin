@using CaptchaMvc.HtmlHelpers;
@using Fanex.Alpha.Before.Customer.Constants
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Fanex.Alpha.Before.Customer.Models.SignInResult

@section styles
{

    <link href="~/assets/bundles/themes/@(Model.LoginTemplate).min.css?ver=@AppSetting.Version" rel="stylesheet" />
}

<div class="box-lang">
    <div class="dropdown">
        <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
            <span class="flag" id="flag"></span>
            <span id="lblLanguage">简体版</span>
            <span class="caret"></span>
            <input type="hidden" value="zh-Hans" id="hidLanguage" name="hidLanguage">
        </span>
        <ul class="dropdown-menu" aria-labelledby="langList" id="language-ddl">
            <li><a href="#"><span class="flag flag-cn" data-language-code="zh-Hans"></span>简体版</a></li>
            <li><a href="#"><span class="flag flag-tw" data-language-code="zh-TW"></span>繁體版</a></li>
            <li><a href="#"><span class="flag flag-en" data-language-code="en-US"></span>English</a></li>
        </ul>
    </div>
</div>

@*<h1 class="title login-text">Login</h1>*@

<div id="loginLevel" class="title-group">
    @if (AppSetting.IsHeadline)
    {
        <span class="login-text">Login</span>
    }
    else
    {
        <span id="login-1" @(Model.LoginLevel == RoleIdConstants.Super ? "class=active" : string.Empty) data-role-id="@RoleIdConstants.Super">Login 1</span>
        <span id="login-2" @(Model.LoginLevel == RoleIdConstants.Master ? "class=active" : string.Empty) data-role-id="@RoleIdConstants.Master">Login 2</span>
        <span id="login-3" @(Model.LoginLevel == RoleIdConstants.Agent ? "class=active" : string.Empty) data-role-id="@RoleIdConstants.Agent">Login 3</span>
    }
    <input type="hidden" id="roleId" name="roleId" value="@Model.LoginLevel" />
    <input type="hidden" id="isHeadline" value="@(AppSetting.IsHeadline ? 1 : 0)" />
</div>

<div class="form-field">
    <div class="rowlg">
        <input type="text" class="txt" placeholder="Username" id="txtUserName" name="txtUserName" tabindex="1" />
        <i class="icon-user"></i>
    </div>

    <div class="rowlg">
        <input type="password" class="txt" placeholder="Password" id="txtPassWord" name="txtPassWord" tabindex="2" autocomplete="off" />
        <i class="icon-lock"></i>
    </div>
</div>

<div class="rowlg checkbox">
    <label>
        <input name="chb-showpass" type="checkbox" id="chbShowPass" tabindex="3" />
        <span id="lbShowPass">Show password</span>
    </label>
</div>

@if (ViewBag.ShowReCaptcha == true)
{
    @Html.Captcha(4, "~/Areas/Captcha/Views/SylouCaptcha/CaptchaPartialView.cshtml", ViewData)
}

<input type="hidden" name="browserSize" id="browserSize" value="" />
<div class="list-button">
    <input type="button" class="btnLogin" value="Login" id="btnLogin" tabindex="5" />
</div>

@if (Model.ErrCode != -1)
{
    <div class="rowlg msg-error" errCode="@Model.ErrCode" id="errmsg">@Model.ErrMsg</div>
}

@if (ViewBag.ShowReCaptcha == true)
{
    @section scripts
    {
        <script src="~/assets/bundles/captcha.js?ver=@Fanex.Alpha.Before.Common.Configurations.AppSetting.Version" type="text/javascript"></script>
    }
}