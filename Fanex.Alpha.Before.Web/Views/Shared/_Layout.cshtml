@using CommonAppSetting = Fanex.Alpha.Before.Common.Configurations.AppSetting
@if (Model is HandleErrorInfo)
{
    Fanex.Logging.Extensions.Web.ExceptionHandler.Handle(Model.Exception);
}
else if (Model.GetType() == typeof(Fanex.Alpha.Before.Customer.Models.SignInResult))
{
    var data = Model as Fanex.Alpha.Before.Customer.Models.SignInResult;

    <!DOCTYPE html>
    <html>
    <head>
        <title>Login</title>
        <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <link href="~/assets/styles/vendors-extensions/login/bootstrap-ex.min.css?ver=@CommonAppSetting.Version" rel="stylesheet" />

        @RenderSection("styles", false)

    </head>
    <body>

        <div id="divLoading" style="display: none">
            <h2>
                Loading... please wait
            </h2>
        </div>

        <div id="mainholder" class="block-login">
            <div class="logo-icon"></div>
            <form id="formLogin" class="form-login" action="@Url.Content("~/")" method="POST" autocomplete="off">
                @RenderBody()
                <input name="code" id="code" type="hidden" value="@Model.Captcha" />
                <input id="detecas-analysis" name="detecas-analysis" value="{}" type="hidden" />
                @Html.AntiForgeryToken()
            </form>
            <div class="banner">
                <img src="~/assets/styles/images/banner/MidAutumn2019/en-US.jpg" alt="Mid-Autumn Festival" />
            </div>
        </div>

        @if (Model.IsChangedPassword)
        {
            <div class="block-info">
                @Model.ChangedPasswordTime
            </div>
        }

        <script src="~/assets/bundles/login.min.js?ver=@CommonAppSetting.Version" type="text/javascript"></script>

        @Html.Partial("FPS", data)

        @RenderSection("scripts", false)

        @Html.Partial("GoogleAnalytic", CommonAppSetting.GoogleAnalyticId)

        @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())

    </body>
</html>
}
