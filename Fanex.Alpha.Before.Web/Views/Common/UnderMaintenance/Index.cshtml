@model UnderMaintenanceModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>UM Page</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
    <link href="~/assets/bundles/themes/um.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="main">
            <div class="icon-um"></div>
            <div class="content">
                <p class="title-chinese">我们的网站正在进行系统维护中</p>
                <p class="title-english">OUR WEBSITE IS UNDER SYSTEM MAINTENANCE</p>
            </div>
        </div>
        <div class="footer">
            <ul>
                <li>
                    <p>在此期间您将无法登入所有网页。<br /> 造成您的不便，我们深感抱歉。</p>
                    <p class="datetime">服務中斷期間 - @Model.UMDateText <br />@Model.FromTimeText ~ @Model.ToTimeText (北京時間)</p>
                </li>
                <li>
                    <p>在此期間您將無法登入所有網頁。<br /> 造成您的不便，我們深感抱歉。</p>
                    <p class="datetime">服务中断期间 - @Model.UMDateText <br />@Model.FromTimeText ~ @Model.ToTimeText (北京时间)</p>
                </li>
                <li>
                    <p>Our website is inaccessible in this time period. <br /> We apologize for the inconvenience caused.</p>
                    <p class="datetime">Service Disruption Period - @Model.UMDateText <br />@Model.FromTimeText ~ @Model.ToTimeText (GMT+8)</p>
                </li>
            </ul>
        </div>
        <div class="copyright">© Copyright @DateTime.Now.Year</div>
    </div>
    @if (Model.ShowCountDown())
    {
        <script type="text/javascript">
            setTimeout(function () {
                window.location.href = window.location.href;
            }, @Model.CountdownTime.TotalMilliseconds);
        </script>
    }
</body>
</html>