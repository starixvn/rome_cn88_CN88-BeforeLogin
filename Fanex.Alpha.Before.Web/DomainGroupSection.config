<?xml version="1.0"?>
<DomainGroupSection>
  <!--IBC Group-->
  <!--ID must equal with before url domain-->
  <!--Copy IBC keys-->
  <!--After path must end with "/"-->
  <DomainGroup id ="1" name="CN88" description="CN88 Group" active="true">
    <Domain>
      <add before="http://10.19.10.7:9115/" after="http://10.19.10.7:9116/site-cn88/" active="true"></add>
      <add before="http://localhost:803/" after="http://localhost:802/site-cn88/" active="true"></add>
      <add before="http://localhost:9192/" after="http://localhost:9191/site-cn88/" active="true"></add>
      <add before="http://localhost:8079/" after="http://localhost:8080/site-cn88/" active="true"></add>
      <add before="http://10.19.10.94:8089/" after="http://10.19.10.94:8088/site-cn88/" active="true"></add>
      <add before="http://localhost:9112/" after="http://localhost:9191/site-cn88/" active="true"></add>
      <add before="http://localhost:12589/" after="http://localhost:61785/" active="true"></add>
      <add before="http://10.18.200.202:8022/I1-Local01/" after="http://10.18.200.202:8021/site-oldmain1/" active="true"></add>
      <add before="http://mbc.playthefun.com/site-main/" after="http://mb.playthefun.com/site-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/IBC Group-->

  <!--Others-->
  <DomainGroup id ="999"
               name="Others"
               description="Others Group"
               active="true">
    <Domain>
      <add before="http://10.19.10.7:9111/site-before/" after="http://10.19.10.7:8989/ex-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/Others-->
</DomainGroupSection>