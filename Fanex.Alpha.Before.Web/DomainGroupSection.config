<?xml version="1.0"?>
<DomainGroupSection>
  <!--IBC Group-->
  <!--ID must equal with before url domain-->
  <!--Copy IBC keys-->
  <!--After path must end with "/"-->
  <DomainGroup id ="1" name="CN88" description="CN88 Group" active="true">
    <Domain>
      <add id="localhost:9192" before="http://localhost:9192/" after="http://localhost:9191/site-cn88/" active="true"></add>
      <add id="10.18.200.112:8021" before="http://localhost:12589/" after="http://localhost:61785/" active="true"></add>

      <add id="10.18.200.202:8022" before="http://10.18.200.202:8022/I1-Local01/" after="http://10.18.200.202:8021/site-oldmain1/" active="true"></add>
      <add id="mbc.playthefun.com/site-main" before="http://mbc.playthefun.com/site-main/" after="http://mb.playthefun.com/site-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/IBC Group-->

  <!--Others-->
  <DomainGroup id ="999"
               name="Others"
               description="Others Group"
               active="true">
    <Domain>
      <add id="localhost:1212" before="http://localhost:1212/" after="http://10.18.200.202:8021/site-oldmain1/" active="true"></add>
      <add id="10.19.10.7:9111" before="http://10.19.10.7:9111/site-before/" after="http://10.19.10.7:8989/ex-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/Others-->
</DomainGroupSection>